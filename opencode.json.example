{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny"
    },
    "external_directory": "ask",
    "skill": "ask",
    "webfetch": "ask"
  }
}
